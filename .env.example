# ============================================================================
# Logo Web IDE - Environment Configuration Example
# ============================================================================
# Copy this file to .env and fill in your values

# ----------------------------------------------------------------------------
# Backend Configuration
# ----------------------------------------------------------------------------

# Server Port
PORT=3001

# Server Host
# Options:
#   - 0.0.0.0: Listen on all network interfaces (external access allowed)
#   - 127.0.0.1 or localhost: Listen on localhost only (local access only)
HOST=0.0.0.0

# Environment (development, production, test)
NODE_ENV=development

# WebSocket Port (optional, defaults to PORT + 1)
WS_PORT=3002


# ----------------------------------------------------------------------------
# Frontend Configuration (VITE_ prefix required for Vite)
# ----------------------------------------------------------------------------

# Frontend Dev Server Port
VITE_PORT=5173

# Frontend Dev Server Host
# Options:
#   - 0.0.0.0: Listen on all network interfaces (external access allowed)
#   - 127.0.0.1 or localhost: Listen on localhost only (local access only)
VITE_HOST=0.0.0.0

# Backend API URL (frontend connects to this)
# Use http://localhost:PORT for local development
# Use your deployed backend URL for production
VITE_API_URL=http://localhost:3001

# Authentication Provider
# Options:
#   - 'mock': Uses localStorage (for local development, no real auth)
#   - 'supabase': Uses Supabase Auth (for production)
VITE_AUTH_PROVIDER=mock


# ----------------------------------------------------------------------------
# Supabase Configuration (only needed when VITE_AUTH_PROVIDER=supabase)
# ----------------------------------------------------------------------------

# Supabase Project URL
# Found in: Supabase Dashboard > Project Settings > API
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Supabase Anonymous Key (Public Key)
# Found in: Supabase Dashboard > Project Settings > API > anon/public key
# This is safe to expose in the browser
VITE_SUPABASE_ANON_KEY=
